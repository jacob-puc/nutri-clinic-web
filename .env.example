# URL base de la API .NET. Sin barra final.
#
# El valor se inyecta en build (Vite solo expone variables VITE_*), asi que
# cambiarlo exige reiniciar `npm run dev`.
#
# Apunta a la raiz del proyecto, no a /api: las rutas ya incluyen el prefijo
# (ver src/features/pacientes/api/pacientes-api.ts).
VITE_API_URL=http://localhost:5036
